# Ondra configuration. Copy to .env (gitignored) and fill in. Every service runs locally with mocks
# and no real accounts; real provider values are only needed when a feature flag turns a provider on.

# --- Database (Postgres 16 + pgvector) ---
# The API connects as ondra_app, which row-level security always applies to.
DATABASE_URL=postgresql+asyncpg://ondra_app:ondra_app_dev@localhost:5432/ondra
# Migrations and the seed script connect as the owner role.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://ondra_owner:ondra_owner_dev@localhost:5432/ondra
# Dev-only passwords used by docker compose when creating the roles. Change them anywhere real.
OWNER_DB_PASSWORD=ondra_owner_dev
APP_DB_PASSWORD=ondra_app_dev

# --- Auth ---
# HMAC secret for access tokens. At least 32 random characters in any shared environment.
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Minutes an access token lives; days a refresh session lives.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- URLs ---
# The dashboard origin (CORS and links in emails).
APP_BASE_URL=http://localhost:3001
# Where the dashboard calls the API (build-time for Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Object storage (MinIO locally, Cloudflare R2 in production; S3 API) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ondra-dev
OBJECT_STORAGE_ACCESS_KEY=ondra
OBJECT_STORAGE_SECRET_KEY=ondra_minio_dev
# Key used to encrypt integration credentials at rest (a KMS key id in production).
ENCRYPTION_KEY_ID=local-dev

# --- AI (Step 2) ---
# Claude API key. Without it the system still runs: the policy layer works, and every message that would reach the
# AI is assigned to a person instead (nothing is sent). evals/run.py needs it to run the golden conversations.
ANTHROPIC_API_KEY=
# The API host the app calls. Set explicitly so an ANTHROPIC_BASE_URL in your shell can't redirect it.
ANTHROPIC_API_BASE=https://api.anthropic.com
# Model for conversations and tool use, and the fast model for classification and summaries (BUILD_PLAN.md 6.1).
MODEL_CONVERSATION=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
# Reasoning effort for replies: low | medium | high. Low keeps text replies within a few seconds.
AGENT_EFFORT=low
# true runs the AI turn before the webhook answers (debugging); false runs it right after (normal).
AGENT_INLINE=false

# Voyage AI embeddings for knowledge search (semantic, multilingual). Without a key, a local mock embedder is
# used and search is closer to word matching. Add a payment method in the Voyage dashboard: without one the
# account is limited to 3 requests a minute and searches fall back to full text.
VOYAGE_API_KEY=

# --- Channels (Step 2+). Each channel uses its mock adapter until its flag is on. ---
# The API's public URL as providers call it. Twilio signs the exact URL, so it must match.
PUBLIC_API_URL=http://localhost:8000
# Shared secret the mock webhooks check (header x-mock-signature). Dev only.
MOCK_WEBHOOK_SECRET=mock-secret

# WhatsApp Cloud API (Meta). Webhook: GET/POST {PUBLIC_API_URL}/webhooks/whatsapp
FEATURE_WHATSAPP=false
WHATSAPP_APP_ID=
# System user or business token, sent as a Bearer token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; enter the same value as the Verify Token in the Meta app dashboard.
WHATSAPP_VERIFY_TOKEN=
# The Meta app secret; webhook payloads are signed with it (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v27.0

# Twilio SMS. Webhook: POST {PUBLIC_API_URL}/webhooks/twilio/sms
FEATURE_SMS=false
TWILIO_ACCOUNT_SID=
# Also the key Twilio signs webhooks with (X-Twilio-Signature).
TWILIO_AUTH_TOKEN=
# Optional: send through a Messaging Service (needed for Advanced Opt-Out) instead of a From number.
TWILIO_MESSAGING_SERVICE_SID=
TELNYX_API_KEY=

# Postmark email. Inbound webhook: https://USER:PASSWORD@your-host/webhooks/postmark/inbound
# (Postmark has no webhook signatures; HTTP Basic auth over HTTPS is its recommended protection.)
FEATURE_EMAIL=false
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=

# --- Voice (Step 5): the apps/voice worker. `docker compose --profile voice up` runs it. ---
# LiveKit Cloud project (cloud.livekit.io > Settings > Keys). The same key pays for LiveKit Inference (STT, TTS,
# turn detection), so no separate speech-to-text key is needed.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk id (ST_...) used to ring staff for warm transfers. Blank: no transfers; the agent hands off
# with a call-back task instead.
LIVEKIT_SIP_OUTBOUND_TRUNK=
# Speech to text through LiveKit Inference, e.g. deepgram/nova-3, deepgram/flux-general-en,
# assemblyai/assemblyai-stt-3-7-realtime-agent. Chosen by the bake-off in Step 5e.
VOICE_STT_MODEL=deepgram/nova-3
# Model for the call. Blank uses MODEL_CONVERSATION. See docs/DECISIONS.md (voice latency) before changing.
VOICE_LLM_MODEL=
# Voice: "inference" (LiveKit Inference, e.g. cartesia/sonic-3, no extra key) or "elevenlabs" (needs ELEVEN_API_KEY).
VOICE_TTS_PROVIDER=inference
VOICE_TTS_MODEL=cartesia/sonic-3
# Voice id for the chosen provider (ElevenLabs voice id, or a Cartesia voice id). Blank: the provider's default.
VOICE_TTS_VOICE=
ELEVEN_API_KEY=
