# Where the "Book a demo" form posts. Any endpoint that accepts a JSON POST works
# (Formspree, Basin, a Supabase edge function, or later apps/api).
# Leave empty to fall back to opening the visitor's email client.
NEXT_PUBLIC_DEMO_FORM_ENDPOINT=

# Shown as the fallback contact address and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@ondra.example

# Canonical URL, used for Open Graph tags. TODO: set once the domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://ondra.example
