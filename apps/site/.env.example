# Where the "Book a demo" form posts. Production uses Formspree: https://formspree.io/f/<form id>,
# delivering to hello@useondra.com (docs/ARCHITECTURE.md). Later this moves to apps/api.
# Leave empty to fall back to opening the visitor's email client.
NEXT_PUBLIC_DEMO_FORM_ENDPOINT=

# Shown as the fallback contact address and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@useondra.com

# Canonical URL, used for Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://useondra.com
